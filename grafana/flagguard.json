{
  "__inputs": [
    {
      "name": "DS_BIGQUERY",
      "label": "BigQuery",
      "description": "BigQuery data source with read access to the flagguard dataset",
      "type": "datasource",
      "pluginId": "grafana-bigquery-datasource",
      "pluginName": "Google BigQuery"
    },
    {
      "name": "VAR_PROJECT",
      "label": "GCP project id",
      "description": "Project that holds the flagguard dataset",
      "type": "constant",
      "value": ""
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.6.0"
    },
    {
      "type": "datasource",
      "id": "grafana-bigquery-datasource",
      "name": "Google BigQuery",
      "version": "3.0.0"
    }
  ],
  "title": "Flag Guard",
  "uid": "flagguard",
  "description": "Feature-flag variants flagged and killed by Flag Guard (github.com/sivaram87/FlagGuard)",
  "tags": [
    "flagguard",
    "mobile",
    "feature-flags"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "timepicker": {
    "refresh_intervals": [
      "15m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "type": "constant",
        "name": "project",
        "label": "GCP project id",
        "query": "${VAR_PROJECT}",
        "hide": 2,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Findings",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${DS_BIGQUERY}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${DS_BIGQUERY}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "rawSql": "SELECT COUNT(*) AS findings FROM `${project}.flagguard.findings` WHERE $__timeFilter(ts)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Kills",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${DS_BIGQUERY}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${DS_BIGQUERY}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "rawSql": "SELECT COUNT(*) AS kills FROM `${project}.flagguard.findings` WHERE $__timeFilter(ts) AND action = 'killed'"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Flags affected",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${DS_BIGQUERY}"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${DS_BIGQUERY}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "rawSql": "SELECT COUNT(DISTINCT flag) AS flags FROM `${project}.flagguard.findings` WHERE $__timeFilter(ts)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Findings per day by signal",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${DS_BIGQUERY}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${DS_BIGQUERY}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 0,
          "rawSql": "SELECT TIMESTAMP_TRUNC(ts, DAY) AS time, signal, COUNT(*) AS findings\nFROM `${project}.flagguard.findings`\nWHERE $__timeFilter(ts)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kills per day",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${DS_BIGQUERY}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${DS_BIGQUERY}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 0,
          "rawSql": "SELECT TIMESTAMP_TRUNC(ts, DAY) AS time, COUNT(*) AS kills\nFROM `${project}.flagguard.findings`\nWHERE $__timeFilter(ts) AND action = 'killed'\nGROUP BY 1\nORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "decimals": 0,
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Recent findings",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${DS_BIGQUERY}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${DS_BIGQUERY}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "rawSql": "SELECT ts, flag, variant, version, signal, crash_rate, control_rate, rate_ratio, top_segment, action\nFROM `${project}.flagguard.findings`\nWHERE $__timeFilter(ts)\nORDER BY ts DESC\nLIMIT 200"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "crash_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "control_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rate_ratio"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "unit",
                "value": "suffix:×"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "action"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "killed": {
                        "color": "red",
                        "index": 0
                      },
                      "kill_capped": {
                        "color": "orange",
                        "index": 1
                      },
                      "already_killed": {
                        "color": "purple",
                        "index": 2
                      },
                      "alerted": {
                        "color": "transparent",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Flags, last 30 days",
      "datasource": {
        "type": "grafana-bigquery-datasource",
        "uid": "${DS_BIGQUERY}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-bigquery-datasource",
            "uid": "${DS_BIGQUERY}"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": 1,
          "rawSql": "SELECT flag, alerts, kills, last_alert, last_action\nFROM `${project}.flagguard.flags_30d`\nORDER BY alerts DESC"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}
